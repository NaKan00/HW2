<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</pattern></encoder>
  </appender>
  <appender name="JSON_REQUESTS" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <logger name="api.requests" level="INFO" additivity="false"><appender-ref ref="JSON_REQUESTS"/></logger>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
